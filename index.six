<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Serah Muindi | Business Psychologist for Founders</title>
    <!-- [Keep all your existing CSS here - it's perfect] -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
    <style>
        /* [Your existing CSS remains unchanged] */
    </style>
</head>
<body>
<!-- [Your existing HTML structure remains unchanged until the audit section] -->

<script>
    // ============================================
    // CONFIGURATION - Fill these in with your free accounts
    // ============================================
    const CONFIG = {
        // Option 1: Google Sheets via Google Apps Script (Recommended - Free)
        googleScriptURL: 'YOUR_GOOGLE_APPS_SCRIPT_URL', // See setup instructions below
        
        // Option 2: MailerLite API (Free up to 1,000 subscribers)
        mailerliteAPI: 'YOUR_MAILERLITE_API_KEY',
        mailerliteGroup: 'YOUR_MAILERLITE_GROUP_ID',
        
        // Option 3: EmailJS (Free 200 emails/month)
        emailjsUserID: 'YOUR_EMAILJS_USER_ID',
        emailjsServiceID: 'YOUR_EMAILJS_SERVICE_ID',
        emailjsTemplateID: 'YOUR_EMAILJS_TEMPLATE_ID',
        
        // Current active system (change to 'google', 'mailerlite', or 'emailjs')
        activeSystem: 'google', // Start with Google Sheets - it's free and reliable
        
        selarProductURL: 'https://serahmuindi.selar.com/9m75i41u05'
    };

    const questions = [
        // [Your existing questions array stays the same]
    ];

    let idx = 0;
    const answers = new Array(questions.length).fill(null);

    // [Your existing render function stays the same]

    function calculateScore() {
        return answers.reduce((total, answerIndex, qIndex) => 
            total + (answerIndex === null ? 0 : questions[qIndex].options[answerIndex].score), 0);
    }

    function resultProfile(score) {
        // [Your existing resultProfile function stays the same]
    }

    // ============================================
    // EMAIL DELIVERY SYSTEMS
    // ============================================

    // System 1: Google Sheets + Apps Script (100% Free, No Limits)
    async function sendViaGoogleSheets(payload) {
        try {
            const response = await fetch(CONFIG.googleScriptURL, {
                method: 'POST',
                mode: 'no-cors', // Required for Google Apps Script
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            return { 
                ok: true, 
                message: 'Your results have been recorded! Check your email shortly.' 
            };
        } catch (error) {
            console.error('Google Sheets error:', error);
            return { ok: false, message: 'Unable to send at this moment.' };
        }
    }

    // System 2: MailerLite (Free tier - 1,000 subscribers)
    async function sendViaMailerLite(payload) {
        try {
            // Add subscriber to MailerLite
            const subscriberResponse = await fetch('https://api.mailerlite.com/api/v2/subscribers', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-MailerLite-ApiKey': CONFIG.mailerliteAPI
                },
                body: JSON.stringify({
                    email: payload.email,
                    name: payload.name,
                    fields: {
                        audit_score: payload.score,
                        audit_profile: payload.profile,
                        audit_summary: payload.summary
                    }
                })
            });

            if (subscriberResponse.ok) {
                // Trigger automation email in MailerLite (set up in their dashboard)
                return { ok: true, message: 'Results sent! Check your inbox.' };
            }
            throw new Error('MailerLite API failed');
        } catch (error) {
            console.error('MailerLite error:', error);
            return { ok: false, message: 'Delivery delayed. Results shown below.' };
        }
    }

    // System 3: EmailJS (200 free emails/month)
    async function sendViaEmailJS(payload) {
        try {
            const response = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    service_id: CONFIG.emailjsServiceID,
                    template_id: CONFIG.emailjsTemplateID,
                    user_id: CONFIG.emailjsUserID,
                    template_params: {
                        to_email: payload.email,
                        to_name: payload.name,
                        audit_score: payload.score,
                        audit_profile: payload.profile,
                        audit_summary: payload.summary,
                        toolkit_link: CONFIG.selarProductURL
                    }
                })
            });
            
            if (response.ok) {
                return { ok: true, message: 'Your detailed results are in your inbox!' };
            }
            throw new Error('EmailJS failed');
        } catch (error) {
            console.error('EmailJS error:', error);
            return { ok: false, message: 'Results ready below. Email will arrive shortly.' };
        }
    }

    // Main send function - routes to active system
    async function sendAuditEmail(payload) {
        switch(CONFIG.activeSystem) {
            case 'google':
                return await sendViaGoogleSheets(payload);
            case 'mailerlite':
                return await sendViaMailerLite(payload);
            case 'emailjs':
                return await sendViaEmailJS(payload);
            default:
                return { ok: false, message: 'Email system not configured.' };
        }
    }

    // [Keep your existing button handlers the same]
    document.getElementById('nextQuestionBtn').addEventListener('click', () => {
        // [Your existing code]
    });

    document.getElementById('getResultsBtn').addEventListener('click', async () => {
        const name = document.getElementById('auditName').value.trim();
        const email = document.getElementById('auditEmail').value.trim();
        
        if (!email) {
            alert('Please enter your email address.');
            return;
        }

        // Show loading state
        const btn = document.getElementById('getResultsBtn');
        btn.textContent = 'Sending...';
        btn.disabled = true;

        const score = calculateScore();
        const profile = resultProfile(score);
        const payload = {
            name: name || 'Founder',
            email,
            score,
            profile: profile.title,
            summary: profile.summary,
            toolkit_preview_link: CONFIG.selarProductURL,
            submitted_at: new Date().toISOString()
        };

        const sendResult = await sendAuditEmail(payload);

        // Show results page
        document.getElementById('emailStep').classList.remove('active');
        document.getElementById('resultStep').classList.add('active');
        document.getElementById('resultTitle').textContent = profile.title;
        document.getElementById('resultScore').textContent = `${score}/35`;
        document.getElementById('resultSummary').textContent = profile.summary;
        document.getElementById('deliveryMessage').innerHTML = `
            <strong>${sendResult.message}</strong><br><br>
            <small>Your Score: ${score}/35 — ${profile.summary}</small>
            ${!sendResult.ok ? `<br><small style="color: var(--accent-gold);">Save your results: screenshot this page or <a href="mailto:${email}?subject=My Pricing Audit Results&body=Score: ${score}/35 - ${profile.summary}" style="color: var(--accent-gold);">email yourself</a></small>` : ''}
        `;

        btn.textContent = 'Email my results →';
        btn.disabled = false;
    });

    // [Keep your existing helper functions]
    function wireSelarLinks() {
        // [Your existing code]
    }

    function setEarlyBirdDeadline() {
        // [Your existing code]
    }

    // Initialize
    wireSelarLinks();
    renderQuestion();
    setEarlyBirdDeadline();
</script>
</body>
</html>
